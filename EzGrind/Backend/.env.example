# Copy this file to .env in the same directory, then fill in the blanks.
#   cd EzGrind/Backend
#   copy .env.example .env        (Windows)   /   cp .env.example .env  (macOS, Linux)
#
# .env is gitignored. Never commit real values.
#
# Flask serves the frontend as well as the API, so the whole app is ONE origin.
# Open http://127.0.0.1:5000 - not Live Server. That is what lets the frontend
# call /api relatively instead of hardcoding a host.

# ---- Required. The app refuses to start without these. ----
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT one in production than in development. Rotating it signs
# everyone out; nothing else breaks, because reset tokens live in the database.
SECRET_KEY=

# The whole connection in one string, copied from the Neon dashboard:
#   Connection Details -> psycopg2
# sslmode=require is appended automatically if you leave it off. Neon refuses
# plaintext connections, but libpq's default would silently downgrade rather
# than fail, so it is forced rather than trusted.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ezgrind?sslmode=require

# Required only when EMAIL_BACKEND=resend. A server that boots without it looks
# healthy while every password reset silently fails.
RESEND_API_KEY=

# ---- Environment ----
# development -> debug on,  session cookie Secure=False
# production  -> debug off, session cookie Secure=True (needs HTTPS)
# Anything other than "development" is treated as production.
FLASK_ENV=development

# ---- Database ----
# The role in DATABASE_URL owns the schema on Neon's default setup. For a
# production deployment create a second role that only the app uses:
#   CREATE ROLE ezgrind_app LOGIN PASSWORD '<strong-password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public
#     TO ezgrind_app;
#   GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO ezgrind_app;
# Migrations need CREATE/ALTER and should keep running as the owner.

# Pooled connections held open for reuse. 1-20; 5 suits a single dev server.
# The ceiling is Neon's connection limit, not the driver's.
DB_POOL_SIZE=5

# ---- CORS ----
# Same-origin now, so this is unused in the normal setup. It stays for the case
# where the frontend is served from somewhere else - a CDN, a separate host.
ALLOWED_ORIGINS=http://127.0.0.1:5000

# ---- Email (Resend) ----
# console -> prints the whole message to the terminal, sends nothing
# resend  -> really sends, and spends the 100/day free-tier quota
# Defaults to console in development, resend in production.
EMAIL_BACKEND=console

MAIL_FROM_NAME=EzGrind

# MUST be an address on a domain you have verified at https://resend.com/domains.
# onboarding@resend.dev is the sandbox sender: it only delivers to the address
# that owns the Resend account, so every other user gets NOTHING and the app
# still reports success. Do not launch with it.
MAIL_FROM_ADDRESS=onboarding@resend.dev

# The public root of the site. Emails cannot use relative URLs, so this is the
# one absolute address still needed - every reset and welcome link is built
# from it. In production this is your https:// domain. If it says localhost,
# every link you send is dead.
APP_BASE_URL=http://127.0.0.1:5000
